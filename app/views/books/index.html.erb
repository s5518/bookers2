<%= render 'list' %>


<h2>Books</h2>

  <table>
    <head>
      <tr>
        <th colspan="1"></th>
        <th>Title</th>
        <th>Opinion</th>
      </tr>
    </head>
  
    <body>
      <% @books.each do |book| %> 
        <tr>
          <td><%= image_tag book.user.get_profile_image(100,100) %></td>
          <td><%= link_to book.title, user_path(book.user) %></td>
          <td><%= book.body %></td>
        </tr>
      <% end %>
    </body>
  </table>