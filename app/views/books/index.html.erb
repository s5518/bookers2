<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render 'list' %>
    </div>
    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>
      <table class="table table-hover">
        <head>
          <tr>
            <th colspan="1"></th>
            <th>Title</th>
            <th>Opinion</th>
          </tr>
        </head>
  
        <body>
          <% @books.each do |book| %> 
            <tr>
              <td>
                <%= link_to user_path(book.user.id) do %>
                  <%= image_tag book.user.get_profile_image(100,100) %>
                <% end %>
              </td>
              <td><%= link_to book.title, book_path(book.id), class: "text-decoration-none" %></td>
              <td><%= book.body %></td>

              <% if book.favorited_by?(Current.user) %>
                <td>
                  <%= link_to book_favorite_path(book), data: { turbo_method: :delete }, class: "text-decoration-none" do %>
                    <span class="<%= 'text-danger' if book.favorites.count > 0 %>">
                      <i class="fa-solid fa-heart" ></i><%= book.favorites.count %>
                    </span>
                  <% end %>
                </td>
              <% else %>
                <td>
                  <%= link_to book_favorite_path(book), data: { turbo_method: "post" }, class: "text-decoration-none" do %>
                    <i class="fa-solid fa-heart"></i><%= book.favorites.count %>
                  <% end %>
                </td>
              <% end %>
              
            </tr>
          <% end %>
        </body>
      </table>
    </div>
  </div>
</div>