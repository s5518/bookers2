<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render 'list', user: @user %>
    </div>
    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>
      <div class="mb-3">
        <%= link_to '新しい順', books_path(latest: "true"), class: "text-primary mr-3" %> |
        <%= link_to '評価の高い順', books_path(star_count: "true"), class: "text-primary ml-3" %>
      </div>      
      <table class="table table-hover">
        <head>
          <tr>
            <th colspan="1"></th>
            <th>Title</th>
            <th>Opinion</th>
            <th>Tag</th>
          </tr>
        </head>
  
        <body>
          <% @books.each do |book| %> 
            <tr>
              <td class="col-2 pb-0">
                <%= link_to user_path(book.user.id) do %>
                  <%= image_tag book.user.get_profile_image(100,100) %>
                <% end %>
              </td>
              <td class="col-2 pb-0"><%= link_to book.title, book_path(book.id), class: "text-decoration-none" %></td>
              <td class="col-2 pb-0"><%= book.body %></td>
              <td>
                <% if book.category.present? %>
                  <%= link_to book.category, search_tag_path(category: book.category) %>
                <% end %>
              </td>
              <td class="col-0.5 pb-0">
                <%= turbo_frame_tag dom_id(book, :favorite) do %>
                  <%= render 'favorites/favorite_btn', book: book %>
                <% end %>
              </td>

              <td class="col-1.5 pb-0">
                <p>コメント数：<%= book.post_comments.count %></p>
              </td>
              
              <td>
                <div class="show_raty" id="show_raty-<%= book.id %>" data-score="<%= book.star %>"></div>
              </td>
            </tr>
          <% end %>
        </body>
      </table>
    </div>
  </div>
</div>