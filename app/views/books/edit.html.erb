<div class="container">
  <div class="row">
    <div class="col-md-6 mx-auto">
      <h2>Editing Book</h2>

      <% if @book.errors.any? %>
        <h2><%= @book.errors.count %> errors prohibited this book form being saved: </h2>
        <ul>
          <% @book.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>


      <%= form_with model: @book, url: book_path(@book.id), method: :patch do |f| %>

        <div>
          <p>Title</p>
          <%= f.text_field :title, class: "form-control" %>
  
          <p>Opinion</p>
          <%= f.text_area :body, class: "form-control" %>
        </div>

        <div class="show_raty" id="show_raty-<%= @book.id %>" data-score="<%= @book.star %>"></div>
        
        <div>
           <%= f.submit 'Update Book', class: "btn btn-success" %>
        </div>
      <% end %>

      <%= link_to "Show", book_path(@book.id) %>
      <span> | </span>
      <%= link_to "Back", books_path %>
    </div>
  <div>
</div>  