<div class="container px-5 px-sm-o">

<h2>User info</h2> 
  <table class="table">
    <body>
      <tr>
        <td colspan="2" class="text-center">
          <%= image_tag user.get_profile_image(100,100) %>
        </td>
      </tr>
      <tr>
        <th>name</th>
        <th><%= user.name %></th>
      </tr>
      <tr>
        <th>introduction</th>
        <th><%= user.introduction %></th>
      </tr>
      <tr>
        <th>follows</th>
        <th><%= link_to user.followings.count, user_followings_path(user) %></th>
      </tr>
      <tr>
        <th>followers</th>
        <th><%= link_to user.followers.count, user_followers_path(user) %></th>
      </tr>
    </body>
  </table>

  <div class="row mb-3">
    <% if Current.user != @user %>
      <td><%= render "relationships/btn", user: user, options: { class: ""} %></td>
    <% else %>
      <% unless Current.user.guest_user? %>
        <%= link_to edit_user_path(user), class: "btn btn-outline-secondary btn-block w-100" do %>
          <i class="fa-solid fa-user-gear"></i>
        <% end %>
      <% end %>
    <% end %>
  </div>


  <h2 class="mt-3">New book</h2>
    <%= form_with model: @book, local: true do |f| %>
      <h4>Title</h4>
      <%= f.text_field :title %>
      <h4>Opinion</h4>
      <%= f.text_area :body %>
      <div class="form-group" %>
        <%= f.label :category, 'Tag' %>
        <%= f.text_field :category %>
      </div>
      <div class="form-group" id="star">
        <%= f.label :star, 'Rate' %>
        <div id="post_raty"></div>
      </div>

      <div>
        <%= f.submit 'Create Book', class:"btn btn-success" %>
      </div>
    <% end %>
</div>