<div>
  <p>ショップ名：<%= @book.shop_name %></p>
  <p>説明：<%= @book.caption %></p>
  <p>投稿ユーザー画像：#<%= image_tag 'sample-author1.jpg' %>
  </p>
  <% if @book.user == Current.user %>
    <%= link_to "Destroy", book_path(@book), data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" } %>
  <% end %>
</div>
