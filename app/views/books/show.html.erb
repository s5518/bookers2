<div class="container px-5 px-sm-0">
  <div class="row">

    <div class="col-md-3">
      <%= render 'list', user: @user %>
    </div>
    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>
      <table class="table table-borderless mb-0">
        
        <body>
          <tr>
            <td class="col-2 pb-0"><%= image_tag @book_detail.user.get_profile_image(100,100) %></td>
            <td class="col-1.5 pb-0"><%= link_to @book_detail.title, book_path(@book_detail.id), class: "text-decoration-none" %></td>
            <td class="col-1.5 pb-0"><%= @book_detail.body %></td>
            <td>
              <% if @book_detail.category.present? %>
                <%= link_to @book_detail.category, search_tag_path(category: @book_detail.category) %>
              <% end %>
            </td>
            <td class="col-0.5 pb-0">
              <%= turbo_frame_tag dom_id(@book_detail, :favorite) do %>
                <%= render 'favorites/favorite_btn', book: @book_detail %>
              <% end %>
            </td>
            <td class="col-1 pb-0">
              <p>コメント数：<%= @book_detail.post_comments.count %></p>
            </td>
            <td>
              <div class="show_raty" id="show_raty-<%= @book_detail.id %>" data-score="<%= @book_detail.star %>"></div>
            </td>
            <% if @book_detail.user.id == Current.user.id %>
              <td class="col-0.5 pb-0"><%= link_to "Edit", edit_book_path(@book_detail), class: "btn btn-success text-white" %></td>
              <td class="col-0.5 pb-0"><%= link_to "Destroy", book_path(@book_detail), data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" }, class: "btn btn-danger text-white" %></td>
            <% end %>
          </tr>
        </body>
      </table>
      <%= link_to @book_detail.user.name, user_path(@book_detail.user.id), class: "text-decoration-none" %>

      <div id="comments_area">
        <%= render 'post_comments/index', book: @book_detail %>
      </div>
      <div id="comments_form_area">
        <%= render 'post_comments/form', book: @book_detail, post_comment: @post_comment %>
      </div>

    </div>
  </div>
</div>