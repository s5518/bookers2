<%= render 'list' %>


<section class="book-list-section">

  <h2>Book detail</h2>

  <table>
    <head>
      <tr>
        <th>Title</th>
        <th>Opinion</th>
        <th colspan="2"></th>
      </tr>
    </head>
  
    <body>
      <tr>
        <td><%= @book_detail.title %></td>
        <td><%= @book_detail.body %></td>
        <% if @book.user_id == Current.user.id %>
          <td><%= link_to "Edit", edit_book_path(@book_detail) %></td>
          <td><%= link_to "Destroy", book_path(@book_detail), data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" } %></td>
        <% end %>
      </tr>
    </body>
  </table>
  <%= link_to @book_detail.user.name, user_path(@book_detail.user.id) %>
  
</section>