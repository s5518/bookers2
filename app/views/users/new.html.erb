<h1>Sign up</h1>

<%= form_with model: @user, url: users_path do |f| %>
  <% if @user.errors.any? %>
      <h2><%= @user.errors.count %> errors prohibited this book form being saved: </h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
  <% end %>
  
  <div class="field">
    <%= f.label :name %><br>
    <%= f.text_field :name, autofocus: true %>
  </div>

  <div class="field">
    <%= f.label :email_address, "Email" %><br>
    <%= f.email_field :email_address %>
  </div>

  <div class="field">
    <%= f.label :password, "Password(6 characters minimum)" %><br>
    <%= f.password_field :password %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br>
    <%= f.password_field :password_confirmation %>
  </div>

  <div class="mb-2">
    <%= f.submit "Sign up", class: "btn btn-success text-white" %>
  </div>
<% end %>

<div>
<%= link_to "Log in", new_session_path, class: "text-decoration-none" %>
</div>