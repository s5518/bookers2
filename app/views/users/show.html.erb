<section class="user-edit-section">

<h2>User info</h2> 
  <%= form_with model: @user, local: true do |f| %> 
   
    <div>
      <%= f.label :name, "name" %>
      <%= f.text_field :name %>
    </div>
    <div>
      <%= f.label :introduction, "introduction" %>
      <%= f.text_field :introduction %>
    </div>
    <div>
      <%= f.submit "更新マークを入れる" %>
    </div>
  <% end %>
</section>

<section class="book-new-section">

<h2>New Book</h2>
  <%= form_with model: @book, local: true do |f| %>
    <h4>Title</h4>
    <%= f.text_field :title %>
    <h4>Opinion</h4>
    <%= f.text_area :body %>
    <div>
      <%= f.submit 'Create Book' %>
    </div>
  <% end %>
</section>


<section class="book-list-section">

  <h2>Books</h2>

  <table>
    <head>
      <tr>
        <th>Title</th>
        <th>Opinion</th>
        <th colspan="2"></th>
      </tr>
    </head>
  
    <body>
      <% @books.each do |book| %> 
        <tr>
          <td><%= book.title %></td>
          <td><%= book.body %></td>
          <td><%= link_to "Edit", edit_book_path(book.id) %></td>
          <td><%= link_to "Destroy", book_path(book.id), data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" } %></td>
          </tr>
      <% end %>
    </body>
  </table>
  
</section>