<%= render 'books/list' %>





<section class="book-list-section">

  <h2>Books</h2>

  <table>
    <head>
      <tr>
        <th>Title</th>
        <th>Opinion</th>
      </tr>
    </head>
  
    <body>
      <% @books.each do |book| %> 
        <tr>
          <td><%= link_to book.title, book_path(book) %></td>
          <td><%= book.body %></td>
        </tr>
      <% end %>
    </body>
  </table>
  
</section>