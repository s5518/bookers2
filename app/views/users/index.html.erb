<%= render 'books/list' %>

<h2>Users</h2>

  <table>
    <head>
      <tr>
        <th>image</th>
        <th>name</th>
        <th colspan="1"></th>
      </tr>
    </head>
  
    <body>
      <% @users.each do |user| %> 
        <tr>
          <td><%= image_tag user.get_profile_image(100,100) %></td>
          <td><%= user.name %></td>
          <td><%= link_to "Show", user_path(user) %></td>
        </tr>
      <% end %>
    </body>
  </table>