<div class="container px-5 px-sm-o">
  <div class="row">

    <div class="col-md-3">
      <%= render 'books/list' %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Users</h2>
      <table class="table table-hover">
        <head>
          <tr>
            <th>image</th>
            <th>name</th>
            <th colspan="1"></th>
          </tr>
        </head>
  
        <body>
          <% @users.each do |user| %> 
            <tr>
              <td><%= image_tag user.get_profile_image(100,100) %></td>
              <td><%= user.name %></td>
              <td><%= link_to "Show", user_path(user), class: "text-decoration-none" %></td>
            </tr>
          <% end %>
        </body>
      </table>
    </div>
  </div>
</div>