<h2>User info</h2>
<%= form_with model: @user do |f| %>
  <% if @user.errors.any? %>
  <h2><%= @user.errors.count %> errors prohibited this book form being saved: </h2>
  <ul>
    <% @user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

  <div>
    <label for="inputName">Name</label><br>
    <%= f.text_field :name, autofocus: true, id:"inputName" %>
  </div>

  <div>
    <label for="inputImage">Image</label><br>
    <%= f.file_field :profile_image, accept: "image/*" %>  
  </div>

  <div>
    <label for="inputIntroduction">Introduction</label><br>
    <%= f.text_area :introduction, id:"inputIntroduction" %>
  </div>

  <div>
    <%= f.submit "Update User" %>
  </div>
<% end %>