<div>
<%= flash[:notice] %>
</div>

<%= form_with url: session_path do |form| %>
  <%= form.text_field :name, autofocus: true, autocomplete: "username", value: params[:name] %><br>
  <%= form.password_field :password, autocomplete: "current-password", maxlength: 72 %><br>
  <%= form.submit "Log in" %>
<% end %>

<div>
<%= link_to "Sign up", new_user_path %>
</div>
<div>
<%= link_to "Forgot password?", new_password_path %>
</div>