<div>
<%= flash[:notice] %>
</div>

<h1>Log in</h1>
<%= form_with url: session_path do |form| %>
  <div class="mb-3">
    <%= form.label :name %></label><br>
    <%= form.text_field :name, autofocus: true, autocomplete: "username", value: params[:name] %><br>
    <%= form.label :password %></label><br>
    <%= form.password_field :password, autocomplete: "current-password", maxlength: 72, size: 20 %><br>
    <%= form.check_box :remember_me %>
    <%= form.label :remember_me, "Remember me"%><br>
    <div class="mb-2">
      <%= form.submit "Log in", class: "btn btn-info text-white" %>
    </div>
  </div>
<% end %>

<div>
<%= link_to "Sign up", new_user_path, class: "text-decoration-none" %>
</div>
<div>
<%= link_to "Forgot password?", new_password_path, class: "text-decoration-none" %>
</div>