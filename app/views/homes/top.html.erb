<div class="row">

  <div class="col-md-6 mx-auto py-5" style="max-width: 500px;">
    <h1 class="fw-bold mb-3">Welcome to <i class="fa-solid fa-book"></i> Bookers!!</h1>
    <p>In <i class="fa-solid fa-book"></i>Bookers,</p>
    <p class="mb-4">you can share and exchange your opinions, inpressions,<br>and emotions</p>
    <p>about various books!</p>

    <div class="d-flex flex-column gap-3">
      <%= button_to "ゲストログイン（閲覧用）", guest_sign_in_path, class: "btn btn-secondary w-100 py-2" %>
